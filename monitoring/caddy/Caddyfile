{
	acme_ca https://ca.lab.example/acme/acme/directory
}

# The internal CA trust bundle must be mounted at /etc/caddy/roots.pem.
# If the CA is unavailable, certificate issuance and mTLS validation will fail closed.

telemetry.lab.example {
	reverse_proxy otel-collector:4318
}

mtls.lab.example {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/roots.pem
		}
	}

	reverse_proxy http://mtls-test:18080
}
