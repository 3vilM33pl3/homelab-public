{
  "file_mappings": [
    {
      "src": "iac_ansible/install-baremetal.yml",
      "dest": "iac_ansible/generated/install-baremetal.source.yml"
    },
    {
      "src": "iac_ansible/install-kubernetes.yml",
      "dest": "iac_ansible/generated/install-kubernetes.source.yml"
    },
    {
      "src": "iac_ansible/install-minio.yml",
      "dest": "iac_ansible/generated/install-minio.source.yml"
    },
    {
      "src": "iac_ansible/inventory-homelab.ini",
      "dest": "iac_ansible/generated/inventory.source.ini"
    }
  ],
  "replacements": [
    { "pattern": "\\bolivier\\b", "replacement": "operator" },
    { "pattern": "metatao\\.net", "replacement": "lab.example" },
    { "pattern": "10\\.22\\.6\\.\\d+", "replacement": "<lan-ip>" },
    { "pattern": "10\\.14\\.0\\.1/24", "replacement": "<vpn-overlay-cidr>" },
    { "pattern": "10\\.8\\.0\\.0/24", "replacement": "<vpn-client-cidr>" },
    { "pattern": "(?m)^ca(?=\\s)", "replacement": "ca-1" },
    { "pattern": "\\bmonolith\\b", "replacement": "edge-1" },
    { "pattern": "\\bwhite\\b", "replacement": "control-1" },
    { "pattern": "\\borange\\b", "replacement": "worker-1" },
    { "pattern": "\\bpink\\b", "replacement": "worker-2" },
    { "pattern": "\\bblue\\b", "replacement": "worker-3" },
    { "pattern": "\\bzero\\b", "replacement": "aux-1" },
    { "pattern": "\\bbunnychow\\b", "replacement": "shared-storage" },
    { "pattern": "\\bHarbor\\b", "replacement": "Registry" },
    { "pattern": "\\bharbor-registry\\b", "replacement": "registry-trust" },
    { "pattern": "\\bharbor\\b", "replacement": "registry" }
  ]
}
